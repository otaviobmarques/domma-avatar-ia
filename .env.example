# ---- Banco ----
# Vazio = Postgres embutido (PGlite) em ./.data/pg — ideal para desenvolvimento.
# Produção: string de conexão do Supabase (Settings → Database → Connection string, modo "Session").
DATABASE_URL=

# ---- Segurança ----
# 32+ caracteres aleatórios. Criptografa as chaves de API (AES-256-GCM). NÃO PERCA: sem ela as chaves salvas ficam ilegíveis.
APP_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria-de-32+chars
# Assina o cookie de sessão.
AUTH_SECRET=troque-por-outro-segredo-longo

# Primeiro administrador (criado automaticamente se não existir nenhum usuário).
# Pode ser um e-mail ou um nome de usuário (ex.: admin). Depois do primeiro acesso, pode apagar ADMIN_PASSWORD.
ADMIN_EMAIL=admin@domma.local
ADMIN_PASSWORD=admin123

# URL pública (usada nos links de aprovação)
APP_URL=http://localhost:3000

# ---- Arquivos ----
# Vazio = disco local em ./.data/files. Produção: Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=avatar

# ---- Worker ----
# 1 = processa a fila dentro do próprio servidor Next (dev / instância única).
# 0 = rode `npm run worker` separado (Railway).
WORKER_INLINE=1
